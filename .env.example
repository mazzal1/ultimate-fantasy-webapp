# Frontend
VITE_AWS_REGION=eu-west-1
VITE_COGNITO_USER_POOL_ID=eu-west-1_example
VITE_COGNITO_USER_POOL_CLIENT_ID=exampleclientid
VITE_APPSYNC_GRAPHQL_ENDPOINT=https://example.appsync-api.eu-west-1.amazonaws.com/graphql
VITE_APPSYNC_AUTH_TYPE=AMAZON_COGNITO_USER_POOLS

# Backend
STAGE=dev
COGNITO_USER_POOL_ID=eu-west-1_example
COGNITO_USER_POOL_CLIENT_ID=exampleclientid
POSTGRES_URI=postgres://username:password@ultimate-fantasy.cluster-xxxx.eu-west-1.rds.amazonaws.com:5432/ultimatefantasy
POSTGRES_SSL=true
AWS_REGION=eu-west-1

# CLI
UF_STAGE=dev
UF_REGION=eu-west-1
UF_STACK_NAME=ultimate-fantasy-dev
